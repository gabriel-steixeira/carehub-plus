# Copie para ".env.carehub-plus-21164" e preencha. Estes valores NÃO são
# segredos; os segredos (token, app secret, verify token) ficam no Secret
# Manager via `firebase functions:secrets:set`.

# Identificação do número de telefone (WhatsApp Manager > API Setup)
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Versão da Graph API usada nas chamadas
WHATSAPP_GRAPH_VERSION=v23.0

# Limite diário de mensagens enviadas por cuidador (controle de custo)
WHATSAPP_DAILY_LIMIT_PER_CAREGIVER=30

# Número do WhatsApp do CareHub, só dígitos com DDI (usado nos links wa.me)
WHATSAPP_DISPLAY_NUMBER=5511999999999

# Modelo do Gemini usado pela Cora e pelo Toke (a chave fica no Secret
# Manager: firebase functions:secrets:set GEMINI_API_KEY)
GEMINI_MODEL=gemini-3.5-flash-lite

# Limites diários (controle de custo e de abuso)
AI_DAILY_LIMIT_PER_PERSON=60
CORA_WHATSAPP_DAILY_LIMIT=40
SOS_DAILY_LIMIT_PER_CAREGIVER=50
SOS_REQUESTS_DAILY_LIMIT_PER_PERSON=5
INVITE_DAILY_LIMIT=20
CODE_ATTEMPTS_DAILY_LIMIT=5
